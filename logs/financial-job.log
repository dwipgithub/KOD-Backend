                JOIN sewa s ON t.id_sewa = s.id
                JOIN kamar k ON s.id_kamar = k.id

                UNION ALL

                SELECT 
                    kp.id_akun AS id_akun,
                    pg.total AS debit,
                    0 AS kredit,
                    pg.tanggal_pengeluaran AS tanggal_transaksi,
                    pg.id_properti
                FROM pengeluaran pg
                LEFT JOIN kategori_pengeluaran kp 
